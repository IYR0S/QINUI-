<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />
    <application android:name=".QinsApplication" android:allowBackup="true" android:label="QINS UI Studio"
        android:supportsRtl="true" android:theme="@style/AppTheme">
        <activity android:name=".QuickPanelActivity" android:label="Quick Panel" />
        <activity android:name=".CrashReportActivity" android:label="QINS diagnostics" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".AppMenuActivity" android:label="@string/app_menu_title" />
        <activity android:name=".HomeStudioActivity" android:label="@string/home_studio" />
        <activity android:name=".ThemeStudioActivity" android:label="@string/theme_studio" />
        <activity android:name=".QinsLauncherActivity" android:label="@string/qins_home" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:label="QINS UI Studio" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
